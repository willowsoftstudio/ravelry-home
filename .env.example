# Copy to .env.local for local development. Never commit real values.
# In Vercel, set every key below in both the Production and Preview environments (ISA ISC-70).

# --- Site identity (public, not a secret) ---
# Default is "Niddy". Changing it needs a redeploy, not a code change.
NEXT_PUBLIC_SITE_NAME=

# --- App URL and OAuth redirect (server only) ---
# Production: https://niddy.vercel.app ; local: https://localhost:3000
# Ravelry only accepts https redirect URIs, so `pnpm dev` runs Next with --experimental-https.
APP_URL=https://localhost:3000
# Optional. Defaults to ${APP_URL}/api/auth/callback. Must match a URI registered
# at https://www.ravelry.com/pro/developer exactly (ISA ISC-84).
RAVELRY_REDIRECT_URI=

# --- Ravelry OAuth app (server only) ---
# "2.1" (default: auth.ravelry.com, PKCE) or "2.0" (www.ravelry.com). The client id and
# secret must come from a key of the same version. 2.0 is the fallback while Ravelry's
# 2.1 login page returns 500.
RAVELRY_OAUTH_VERSION=
RAVELRY_CLIENT_ID=
RAVELRY_CLIENT_SECRET=

# Optional. Space-separated OAuth scopes; default: offline_access (2.1) or offline (2.0), plus forum-write message-write deliveries-read
RAVELRY_SCOPES=

# --- Ravelry read-only basic auth, for public browse (server only) ---
RAVELRY_READONLY_USERNAME=
RAVELRY_READONLY_PASSWORD=

# --- Sessions (server only) ---
# Seals the session cookie (AES-256-GCM). 32+ random bytes: `openssl rand -base64 32`.
# Use a different value in Production and Preview. Changing it signs everyone out.
SESSION_SECRET=

# --- Beta access (server only) ---
# Comma-separated Ravelry usernames allowed to sign in
BETA_ALLOWLIST=
